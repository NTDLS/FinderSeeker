<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<Company>NetworkDLS</Company>
		<Copyright>Copyright © 2026 NetworkDLS</Copyright>
		<Version>0.0.51</Version>
		<Authors>NetworkDLS</Authors>
		<Product>FinderSeeker</Product>

		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<UseWindowsForms>true</UseWindowsForms>
		<ImplicitUsings>enable</ImplicitUsings>
		<LangVersion>latest</LangVersion>
		<ApplicationIcon>FinderSeeker.ico</ApplicationIcon>
		<NoWarn>$(NoWarn);CA1416;WFO1000;WFO5001</NoWarn>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
	</PropertyGroup>

	<ItemGroup>
		<Content Include="FinderSeeker.ico" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<PackageReference Include="NTDLS.Localization" Version="1.0.1" />
		<PackageReference Include="NTDLS.WinFormsHelpers" Version="1.5.0" />
	</ItemGroup>

	<ItemGroup>
		<None Include="Translations\Translations.db" Condition="Exists('Translations\Translations.db')" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<ItemGroup>
		<Using Include="NTDLS.Localization.StaticLocalizer" Static="true" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Tests" />
	</ItemGroup>

	<ItemGroup>
	  <Compile Update="Properties\Resources.Designer.cs">
	    <DesignTime>True</DesignTime>
	    <AutoGen>True</AutoGen>
	    <DependentUpon>Resources.resx</DependentUpon>
	  </Compile>
	</ItemGroup>

	<ItemGroup>
	  <EmbeddedResource Update="Properties\Resources.resx">
	    <Generator>ResXFileCodeGenerator</Generator>
	    <LastGenOutput>Resources.Designer.cs</LastGenOutput>
	  </EmbeddedResource>
	</ItemGroup>

</Project>
